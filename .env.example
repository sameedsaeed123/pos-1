# Neon PostgreSQL Database Connection (Direct endpoint recommended for Prisma interactive transactions)
# Format: postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Application Settings
NEXT_PUBLIC_APP_NAME="Kiryana POS"
NEXT_PUBLIC_DEFAULT_LOCALE="ur"
NEXT_PUBLIC_TIMEZONE="Asia/Karachi"

# FBR Sandbox POS Integration Settings
FBR_SANDBOX_ENABLED="true"
FBR_POS_ID="100101"
FBR_AUTH_BEARER="sandbox_fbr_bearer_token"

